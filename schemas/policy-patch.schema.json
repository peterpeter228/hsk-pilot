{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "policy-patch/1.0"
    },
    "kind": {
      "const": "POLICY_PROPOSAL"
    },
    "chainId": {
      "const": 177
    },
    "account": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "expectedPolicyVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "requestedMode": {
      "enum": [
        "BOUNDED_EXECUTION",
        "ORACLE_GUARDED"
      ]
    },
    "requiresNewSession": {
      "type": "boolean"
    },
    "chainPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBuyPerTradeQuoteRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maxSessionGrossBuyQuoteRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maxUtcDayGrossBuyQuoteRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maxRiskInventoryRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maxSellPerTradeRiskRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "exitMaxPerTradeRiskRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "minTradeIntervalSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "exitMinIntervalSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "maxQuoteSlippageBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "maxQuoteAgeSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "maxIntentTtlSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "validAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validUntil": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exitValidUntil": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": []
    },
    "strategyPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetRiskWeightBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "rebalanceBandBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "stopDrawdownBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "minimumTradeQuoteRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "maxExecutionCostQuoteRaw": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "riskEnabled": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "sourceText": {
      "type": "string",
      "maxLength": 10000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "chainId",
    "account",
    "sessionId",
    "expectedPolicyVersion",
    "requestedMode",
    "requiresNewSession",
    "chainPatch",
    "strategyPatch",
    "sourceText",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-reviewable proposal, never execution authorization",
  "anyOf": [
    {
      "properties": {
        "chainPatch": {
          "minProperties": 1
        }
      }
    },
    {
      "properties": {
        "strategyPatch": {
          "minProperties": 1
        }
      }
    }
  ]
}
