{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "evidence-envelope/1.0"
    },
    "hashAlgorithm": {
      "const": "keccak256-jcs-utf8"
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "trade-commitment/1.0"
        },
        "codeSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "configHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "chainId": {
          "const": 177
        },
        "account": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "mode": {
          "enum": [
            "BOUNDED_EXECUTION",
            "ORACLE_GUARDED"
          ]
        },
        "strategyPolicyHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "snapshotBlockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "snapshotBlockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "snapshotObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "modelProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptHash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          ]
        },
        "action": {
          "enum": [
            "HOLD",
            "REBALANCE",
            "DETERMINISTIC_EXIT"
          ]
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasonSummary": {
          "type": "string",
          "maxLength": 2000
        },
        "riskChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "passed",
              "detail"
            ]
          }
        },
        "sourceDataMode": {
          "enum": [
            "MAINNET_READONLY",
            "FORK",
            "SIMULATION"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "codeSha",
        "configHash",
        "chainId",
        "account",
        "sessionId",
        "policyVersion",
        "mode",
        "strategyPolicyHash",
        "snapshotHash",
        "snapshotBlockNumber",
        "snapshotBlockHash",
        "snapshotObservedAt",
        "modelProvider",
        "modelId",
        "promptHash",
        "action",
        "candidateId",
        "reasonSummary",
        "riskChecks",
        "sourceDataMode"
      ]
    },
    "commitmentHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "intent": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "policyVersion": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "strategyPolicyHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "intentNonce": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "direction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "amountInRaw": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "referenceAmountOutRaw": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "amountOutMinimumRaw": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "quoteObservedAt": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "quoteBlockNumber": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "quoteBlockHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "deadline": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "evidenceHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "sessionId",
            "policyVersion",
            "strategyPolicyHash",
            "intentNonce",
            "direction",
            "amountInRaw",
            "referenceAmountOutRaw",
            "amountOutMinimumRaw",
            "quoteObservedAt",
            "quoteBlockNumber",
            "quoteBlockHash",
            "deadline",
            "evidenceHash"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "EIP-712 message only; semantic uint widths and constraints also required"
        }
      ]
    },
    "intentHash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      ]
    },
    "strategySigner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      ]
    },
    "riskSigner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      ]
    },
    "executionKind": {
      "enum": [
        "ONCHAIN_TX",
        "ETH_CALL",
        "FORK_TX",
        "NONE",
        "LOCAL_TX"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "HOLD",
        "REJECTED",
        "SIGNED",
        "SUBMITTED",
        "MINED",
        "CONFIRMED",
        "FAILED",
        "REORGED",
        "UNKNOWN"
      ]
    },
    "txHash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      ]
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "balanceDeltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "beforeRaw": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 78
          },
          "afterRaw": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 78
          }
        },
        "required": [
          "token",
          "beforeRaw",
          "afterRaw"
        ]
      }
    },
    "feeRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "amountRaw": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 78
          },
          "asset": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "estimated": {
            "type": "boolean"
          }
        },
        "required": [
          "category",
          "amountRaw",
          "asset",
          "source",
          "estimated"
        ]
      }
    },
    "simulationReport": {
      "type": [
        "object",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typedDataDomain": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "chainId",
            "verifyingContract"
          ],
          "properties": {
            "name": {
              "const": "HSKPilotGuard"
            },
            "version": {
              "const": "1"
            },
            "chainId": {
              "const": 177
            },
            "verifyingContract": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        }
      ]
    },
    "strategySignature": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{130}$"
        }
      ]
    },
    "riskSignature": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{130}$"
        }
      ]
    },
    "signedTxInput": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^0x([0-9a-fA-F]{2})*$"
    },
    "executionDataMode": {
      "enum": [
        "LIVE_MAINNET",
        "MAINNET_READONLY",
        "FORK",
        "SIMULATION"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "hashAlgorithm",
    "commitment",
    "commitmentHash",
    "intent",
    "intentHash",
    "strategySigner",
    "riskSigner",
    "executionKind",
    "status",
    "txHash",
    "receipt",
    "balanceDeltas",
    "feeRecords",
    "simulationReport",
    "createdAt",
    "limitations",
    "typedDataDomain",
    "strategySignature",
    "riskSignature",
    "signedTxInput",
    "executionDataMode"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-trade commitment plus post-trade envelope; hash ONLY commitment",
  "description": "Provider receipt/simulationReport preserve raw response objects. Hashing the whole envelope before transaction creates a circular dependency and is forbidden.",
  "allOf": [
    {
      "if": {
        "properties": {
          "executionKind": {
            "enum": [
              "ETH_CALL",
              "NONE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "txHash": {
            "type": "null"
          },
          "receipt": {
            "type": "null"
          },
          "executionDataMode": {
            "enum": [
              "MAINNET_READONLY",
              "FORK",
              "SIMULATION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionKind": {
            "const": "ONCHAIN_TX"
          }
        }
      },
      "then": {
        "properties": {
          "executionDataMode": {
            "const": "LIVE_MAINNET"
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "MINED",
              "CONFIRMED"
            ]
          },
          "executionKind": {
            "const": "ONCHAIN_TX"
          }
        }
      },
      "then": {
        "properties": {
          "typedDataDomain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "chainId",
              "verifyingContract"
            ],
            "properties": {
              "name": {
                "const": "HSKPilotGuard"
              },
              "version": {
                "const": "1"
              },
              "chainId": {
                "const": 177
              },
              "verifyingContract": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          },
          "strategySignature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$"
          },
          "riskSignature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$"
          },
          "receipt": {
            "type": "object"
          }
        }
      }
    }
  ]
}
